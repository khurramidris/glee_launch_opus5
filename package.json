{
  "name": "glee",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "esbuild": "0.28.1",
      "picomatch": "4.0.5"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint src tests scripts/*.mjs *.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm verify:version && pnpm resources:check && pnpm updates:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts",
    "verify:version": "node scripts/verify-release-version.mjs",
    "resources:check": "node scripts/resources.mjs check",
    "updates:check": "node scripts/update-source.mjs check",
    "resources:smoke": "node scripts/resources.mjs smoke",
    "eval:model": "node scripts/resources.mjs smoke --eval"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "~2.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
